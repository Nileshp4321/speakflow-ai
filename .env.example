# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/speakflow-ai
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/speakflow-ai?retryWrites=true&w=majority

# Google Gemini API
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Live API model — currently available stable model for real-time audio
GEMINI_MODEL=gemini-3.8-live

# CORS — set to your frontend origin in production
CORS_ORIGIN=http://localhost:5173

# Client (Vite) — these are exposed to the frontend (no secrets here)
# Used only to point the frontend at the correct backend URL
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000
